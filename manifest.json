{
  "manifest_version": 3,
  "name": "Multi Pane Tab Opener",
  "version": "1.1",
  "description": "Open up to 9 resizable website panes inside a single browser tab, tiled in a grid.",
  "permissions": ["storage", "tabs", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open multi-pane view"
  }
}
